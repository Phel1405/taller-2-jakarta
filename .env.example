# Copia este archivo a .env si quieres cambiar algún valor:
#   cp .env.example .env
# No es obligatorio: docker-compose.yml ya usa estos mismos valores por defecto.
# El archivo .env NO se sube al repositorio (.gitignore ignora *.env).

# --- MySQL (servicio "mysql"; también los usa el datasource MySQLDS de "datos")
MYSQL_DATABASE=taller_solicitudes
MYSQL_USER=taller_user
MYSQL_PASSWORD=taller_pass
MYSQL_ROOT_PASSWORD=root_pass

# --- Usuario de aplicación (ApplicationRealm) del WildFly de Logica.
#     Lo usa el Cliente del host para invocar los EJB de Logica.
#     Se crea al construir la imagen: si lo cambias, usa "docker compose up --build".
LOGICA_APP_USER=logica-app
LOGICA_APP_PASSWORD=logica_pass

# --- Usuario de aplicación (ApplicationRealm) del WildFly de Datos.
#     Lo usará Logica para invocar los EJB de Datos (DATOS_EJB_USER/PASSWORD).
#     Se crea al construir la imagen: si lo cambias, usa "docker compose up --build".
DATOS_APP_USER=datos-app
DATOS_APP_PASSWORD=datos_pass

# --- URL del tier de datos vista desde el contenedor de Logica.
#     Todavía no hay código que la lea.
DATOS_EJB_URL=remote+http://datos:8080
